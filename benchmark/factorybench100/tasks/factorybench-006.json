    "documents": [
      {
        "body": "Release only when the customer is not on credit hold, an effective BOM exists, and every component has enough available stock. Reserve the exact BOM quantity.",
        "category": "order_release",
        "doc_id": "POL-01",
        "sha256": "f02d22e29d62e78093fa85720ae5d9dcd6620f34621e0b615bdc04230e020876",
        "task_id": "factorybench-006",
        "title": "Order release control"
      },
      {
        "body": "Net requirements against unreserved on-hand. Use an approved supplier quote that is valid through the need-by date. Requisitions over the requester's limit require the plant manager's approval.",
        "category": "material_shortage",
        "doc_id": "POL-02",
        "sha256": "8287f3ed9c3e58dec451ad5cafecf9290d43914b8de9c73295991b3b1b30f6e1",
        "task_id": "factorybench-006",
        "title": "Shortage requisition control"
      },
      {
        "body": "Choose an approved supplier. Minimize landed price while meeting the need-by date; break ties by higher quality score, then higher on-time rate. Purchase orders above the buyer's limit require plant-manager approval.",
        "category": "supplier_selection",
        "doc_id": "POL-03",
        "sha256": "4383668b1dfa18fa8bfa36ce6c004af8a8fd59f2da1fe844771a869010911762",
        "task_id": "factorybench-006",
        "title": "Supplier award policy"
      },
      {
        "body": "Receive only against an approved purchase order. Put the lot in inspection status, record accepted and rejected quantities, and release only accepted quantity to stores.",
        "category": "inbound_receipt",
        "doc_id": "POL-04",
        "sha256": "a02e4ace7f6602616e7cdbc8303203697b17ba2a2ec9b3f476cca58765203005",
        "task_id": "factorybench-006",
        "title": "Receiving and inspection policy"
      },
      {
        "body": "Compare invoice, approved PO, and accepted receipt. Approve when quantity is covered and the amount variance is at most 2 percent; otherwise place a variance hold.",
        "category": "invoice_match",
        "doc_id": "POL-05",
        "sha256": "ca8d069caaf86fddb05e407c30d7cd1435621a563d853b50cb2e1121abfbe01a",
        "task_id": "factorybench-006",
        "title": "Three-way match policy"
      },
      {
        "body": "Issue only reserved, unrestricted stock. Use FEFO across eligible lots and start the operation only after the full required quantity has been issued.",
        "category": "production_issue",
        "doc_id": "POL-06",
        "sha256": "31177fc47fcf83d19a85befd57b59ceef1c00974dbf1912741e885574cdddd4f",
        "task_id": "factorybench-006",
        "title": "Material issue policy"
      },
      {
        "body": "A failed inspection requires an immediate lot hold and an open nonconformance. Use REWORK when the defect is recoverable and assign it to the quality engineer.",
        "category": "quality_exception",
        "doc_id": "POL-07",
        "sha256": "063e197d41367f8724a719a7b571f5d3100141a898172abb9720b1ceb339d6db",
        "task_id": "factorybench-006",
        "title": "Nonconformance policy"
      },
      {
        "body": "Complete all operations before closing the work order. Record finished quantity and scrap, then post material, labor, and overhead variance for finance review.",
        "category": "completion_costing",
        "doc_id": "POL-08",
        "sha256": "4192bcbaa10ab85e3bfaf934c0b8d3e3e2faa6bd9646a9fe04c8d991874f0a06",
        "task_id": "factorybench-006",
        "title": "Work-order close policy"
      },
      {
        "body": "Use unrestricted surplus from the donor plant, complete the interplant transfer, and reschedule the receiving work order no earlier than the transfer arrival date.",
        "category": "transfer_reschedule",
        "doc_id": "POL-09",
        "sha256": "2ed97b9f92ffc24650f0e8eeda40cc626fe471e885fb35c8a0a254a778d74f96",
        "task_id": "factorybench-006",
        "title": "Interplant recovery policy"
      },
      {
        "body": "Open a high-priority maintenance work order for the failed workcenter. Reroute production only to a qualified active alternate and reschedule within that center's capacity.",
        "category": "maintenance_recovery",
        "doc_id": "POL-10",
        "sha256": "cf4a6a211491b642667667989c361634f145a2641f70c134a6fa641607de4a2c",
        "task_id": "factorybench-006",
        "title": "Unplanned downtime policy"
      }
    ],

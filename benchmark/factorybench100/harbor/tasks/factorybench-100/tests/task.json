        },
        "where": {
          "resource_id": "factorybench-100-mutation-02",
          "task_id": "factorybench-100"
        }
      },
      {
        "description": "google_sheets.spreadsheets.values.append produced the task-scoped, source-audited state transition.",
        "id": "mutation_03",
        "table": "resource_state",
        "values": {
          "resource_type": "google_sheets.spreadsheets.values",
          "revision": 1,
          "status": "Recorded",
          "system": "google_sheets"
        },
        "where": {
          "resource_id": "factorybench-100-mutation-03",
          "task_id": "factorybench-100"
        }
      }
    ]
  },
  "required_read_calls": [
    {
      "arguments": {},
      "match": "successful_tool_call",
      "tool": "factorybench.context.get"
    },
    {
      "arguments": {
        "fields": "files(id,name,mimeType,modifiedTime,md5Checksum)",
        "pageSize": 50,
        "q": "name contains 'CASE-100' and trashed = false"
      },
      "match": "successful_tool_call",
      "tool": "google_drive.files.list"
    },
    {
      "arguments": {
        "count": 50,
        "query": "\"CASE-100\"",
        "sort": "timestamp",
        "sort_dir": "asc"
      },
      "match": "successful_tool_call",
      "tool": "slack.search_messages"
    },
    {
      "arguments": {
        "format": "full",
        "id": "thread-100",
        "userId": "me"
      },
      "match": "successful_tool_call",
      "tool": "gmail.threads.get"
    },
    {
      "arguments": {
        "includeGridData": false,
        "ranges": [
          "Control!A1:H50"
        ],
        "spreadsheetId": "sheet-100"
      },
      "match": "successful_tool_call",
      "tool": "google_sheets.spreadsheets.get"
    },
    {
      "arguments": {
        "purchaseOrdersUniqID": "purchaseOrdersUniqID-0100"
      },
      "match": "successful_tool_call",
      "tool": "oracle_fusion.purchase_orders.get"
    },
    {
      "arguments": {
        "limit": 50,
        "onlyData": true,
        "purchaseOrdersUniqID": "purchaseOrdersUniqID-0100",
        "q": "ReferenceNumber='CASE-100'"
      },
      "match": "successful_tool_call",
      "tool": "oracle_fusion.purchase_order_lines.list"

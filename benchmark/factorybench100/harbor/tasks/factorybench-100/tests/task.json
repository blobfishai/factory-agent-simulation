        "table": "resource_state",
        "values": {
          "payload_json": "{\"arguments\":{\"purchaseOrdersUniqID\":\"purchaseOrdersUniqID-0100\",\"requestBody\":{\"closeAction\":\"finallyClose\",\"closeReason\":\"Verify the final receipt, invoice validation, and no open schedules before closing for receiving and invoicing.\"}},\"case\":\"CASE-100\",\"outcome\":\"Verify the final receipt, invoice validation, and no open schedules before closing for receiving and invoicing.\",\"tool\":\"oracle_fusion.purchase_orders.close\"}",
          "resource_type": "oracle_fusion.purchase_orders",
          "revision": 1,
          "status": "Outside-processing PO closed",
          "system": "oracle_fusion"
        },
        "where": {
          "resource_id": "factorybench-100-mutation-01",
          "task_id": "factorybench-100"
        }
      },
      {
        "description": "google_drive.approvals.approve produced the task-scoped, source-audited state transition.",
        "id": "mutation_02",
